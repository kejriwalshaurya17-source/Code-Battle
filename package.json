{
  "name": "codebattle",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently \"npm run server:dev\" \"npm --prefix client run dev\"",
    "server:dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "test": "node server/integration-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
